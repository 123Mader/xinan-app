<?xml version="1.0" encoding="utf-8"?>
<!-- 心安: 允许内网/本地后端明文 HTTP (测试期, 后端 server.js 跑在 10.0.0.1 等) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
